# ============================================================
#  TCC Voice Agent — Environment configuration
#  Copy to ".env" and fill in. Never commit the real .env.
# ============================================================

# --- Runtime ---
PORT=3000
# DRY_RUN=true  -> no external API calls; everything is logged instead (use for local testing)
DRY_RUN=true
# Public base URL where THIS service is reachable (used to build Bolna webhook URLs)
PUBLIC_BASE_URL=https://voice.theconsultingcrew.in
# Shared secret required in the "x-api-key" header for /calls/outbound, /billing, /optout.
# In n8n, store this same value as env TCC_API_KEY and send it as the x-api-key header.
INTERNAL_API_KEY=change-me-to-a-long-random-string

# --- Compliance guardrails ---
# Calling window in IST (24h). TRAI-safe default 9am-9pm.
CALL_WINDOW_START=9
CALL_WINDOW_END=21
# Days a number stays suppressed after an opt-out (TRAI: 90-day cool-off)
OPTOUT_SUPPRESSION_DAYS=90

# --- Economics ---
# Your all-in platform cost per minute (for live margin calc). ~5.5 managed, ~3.5 BYOK.
COGS_PER_MIN=5.5

# --- Bolna (the voice-agent brain) ---
BOLNA_API_KEY=
BOLNA_BASE_URL=https://api.bolna.ai
# Secret appended to each agent's webhook URL (?token=...) and verified by this service.
# create-agents bakes it into every webhook_url; keep it set in production.
BOLNA_WEBHOOK_TOKEN=change-me-webhook-secret
# The +91 number (E.164) purchased in Bolna via Plivo/Exotel that outbound calls originate from
BOLNA_FROM_NUMBER=+9199XXXXXXXX
# LLM used inside the agents (kept cheap by default)
BOLNA_LLM_PROVIDER=openai
BOLNA_LLM_MODEL=gpt-4.1-mini

# --- Zoho CRM (India DC) ---
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# --- Interakt (WhatsApp) ---
INTERAKT_API_KEY=
INTERAKT_BASE_URL=https://api.interakt.ai
# Approved template names (change to match your Interakt templates)
INTERAKT_TPL_WELCOME=tcc_new_lead_welcome
INTERAKT_TPL_PAYMENT=tcc_invoice_sent
INTERAKT_TPL_GST=tcc_gst_reminder

# --- Team escalation (optional) ---
# Where "needs human / hot lead" alerts go. Phone in E.164 for WhatsApp, or a Slack webhook URL.
ESCALATION_WHATSAPP=+919251022710
SLACK_WEBHOOK_URL=
